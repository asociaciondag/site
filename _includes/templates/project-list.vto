<article class="project project-list">
  <a href="{{ project.external_url }}">
    <figure class="project-image">
      <img width="420" height="200" src="{{ project.cover }}">
    </figure>

    <header class="project-header">
      <h1>
        {{ project.title }}
      </h1>
    </header>
  </a>
</article>
