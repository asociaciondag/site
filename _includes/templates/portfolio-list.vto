<article>
  <a href="{{ portfolio.url }}">
    <header>
      <h1>{{ portfolio.title }}</h1>

      <ul class="portfolio-authors">
        {{ for member of portfolio.members }}
          <li class="member-avatar">
            <img
              src="{{ member.avatar }}"
              width="48"
              height="48"
              alt="{{ member.name }}"
            >
            <span>{{ member.name }}</span>
          </li>
        {{ /for }}
      </ul>
    </header>

    <figure>
      <img src="{{ portfolio.cover }}" width="420" height="200" alt="">
    </figure>
  </a>
</article>
