---
layout: layouts/base.vto
---

<header class="header">
  <h1 class="header-title">{{ title }}</h1>
</header>

<div class="blocks">
  {{ for block of body }}
    {{ await comp[block.type](block) }}
  {{ /for }}
</div>

<nav>
  <ul>
    {{ for p of search.pages(`type=about lang=${lang}`, "order=asc") }}
      <li {{ if p.url == url }} class="is-active"{{ /if }}>
        <a href="{{ p.url }}">{{ p.title }}</a>
      </li>
    {{ /for }}
  </ul>
</nav>
