---
layout: ./base.vto
---

<article>
  <header>
    <h1>{{ title }}</h1>
  </header>

  {{ if info }}
    <dl class="portfolio-data">
      {{ for item of info }}
        <dt>{{ item.name }}</dt>
        <dd>{{ item.value }}</dd>
      {{ /for }}
    </dl>
  {{ /if }}

  <ul>
    {{ for member of members }}
      <li>
        <a href="{{ member.url }}">
          <img
            src="{{ member.avatar }}"
            width="48"
            height="48"
            alt="{{ member.name }}"
          >
          <span>{{ member.name }}</span>
        </a>
      </li>
    {{ /for }}
  </ul>

  <div>
    {{ for block of body }}
      {{ await comp[block.type](block) }}
    {{ /for }}
  </div>
</article>
