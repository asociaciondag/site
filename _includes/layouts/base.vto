<!DOCTYPE html>

<html lang="{{ lang }}">
  <head>
    <meta charset="utf-8">
    <title>{{ title }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/style.css">
  </head>

  <body>
    <header class="page-header">
      <a href='{{ lang === "gl" ? "/" : `/${lang}` }}'>
        <img src="/img/icons/dag.svg" alt="Asociación Galega de Deseño" inline>
      </a>

      {{# Menú principal #}}
      <nav class="page-menu">
        <ul>
          {{ set page = search.page(`id=about lang=${lang}`) }}
          <li {{ if main_menu == page.main_menu }} class="is-selected"{{ /if }}>
            <a href="{{ page.url }}">{{ t.menu.about }}</a>
          </li>

          {{ set page = search.page("id=news lang=" + lang) }}
          <li {{ if main_menu == page.main_menu }} class="is-selected"{{ /if }}>
            <a href="{{ page.url }}">{{ page.title }}</a>
          </li>

          {{ set page = search.page("id=articles lang=" + lang) }}
          <li {{ if main_menu == page.main_menu }} class="is-selected"{{ /if }}>
            <a href="{{ page.url }}">{{ t.menu.articles }}</a>
          </li>

          {{ set page = search.page("id=projects lang=" + lang) }}
          <li {{ if main_menu == page.main_menu }} class="is-selected"{{ /if }}>
            <a href="{{ page.url }}">{{ t.menu.projects }}</a>
          </li>

          {{ set page = search.page("id=members lang=" + lang) }}
          <li {{ if main_menu == page.main_menu }} class="is-selected"{{ /if }}>
            <a href="{{ page.url }}">{{ page.title }}</a>
          </li>

          {{ set page = search.page("id=portfolio lang=" + lang) }}
          <li {{ if main_menu == page.main_menu }} class="is-selected"{{ /if }}>
            <a href="{{ page.url }}">{{ page.title }}</a>
          </li>

          <li>
            {{ for alternate of alternates }}
              <a href="{{ alternate.url }}">{{ alternate.lang }}</a>
            {{ /for }}
          </li>
        </ul>
      </nav>
    </header>

    <main>
      {{ content }}
    </main>

    <!-- FOOTER -->
    <footer>
      <address>
        {{ t.footer.address |> md }}
      </address>

      <div>
        <h4>{{ t.footer.follow }}</h4>

        <ul class="social">
          <li>
            <a href="https://x.com/asociaciondag">
              X
            </a>
          </li>
          <li>
            <a
              href="https://es-es.facebook.com/pages/DAG-Asociaci%C3%B3n-Galega-de-Dese%C3%B1adores/149460691764713"
            >
              Facebook
            </a>
          </li>
          <li>
            <a href="https://www.instagram.com/asociaciondag/">
              Instagram
            </a>
          </li>
          <li>
            <a href="https://www.youtube.com/user/dagasociacion/videos">
              Youtube
            </a>
          </li>
          <li>
            <a href="http://www.designread.es">
              {{ t.footer.read_member }}
            </a>
          </li>
        </ul>
      </div>

      <nav>
        {{ for p of search.pages("footer=true lang=" + lang) }}
          <a href="{{ p.url }}">{{ p.title }}</a>
        {{ /for }}
      </nav>
    </footer>

    {{ include "templates/scripts.vto" }}
  </body>
</html>
