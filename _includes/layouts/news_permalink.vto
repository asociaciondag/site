---
layout: layouts/base.vto
---
<article>
  <header>
    <nav>
      {{ for tag of tags }}
        <a href="/tags/{{ tag }}">{{ tag }}</a>
      {{ /for }}
    </nav>

    <time datetime='{{ date |> date("DATETIME") }}'>
      {{ date |> date("HUMAN_DATE") }}
    </time>

    <h1>{{ title }}</h1>
  </header>

  <div>
    {{ intro |> md }}
  </div>

  <div>
    {{ for block of body }}
      {{ await comp[block.type](block) }}
    {{ /for }}
  </div>
</article>
