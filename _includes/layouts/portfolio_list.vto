---
layout: ./base.vto
---

<header class="header">
  <h1 class="header-title">{{ title }}</h1>

  <div class="header-subtitle">{{ description |> md }}</div>

  <div class="header-filter ly-tags">
    {{ for tag of search.values("tags", "type=portfolio lang=" + lang).sort() }}
      <span class="filter">{{ tag }}</span>
    {{ /for }}
  </div>
</header>

<div class="ly-columns portfolio-list top-xl-2xl">
  {{ for portfolio of results }}
    {{ include "templates/portfolio-list.vto" { portfolio } }}
  {{ /for }}
</div>

<nav class="pagination">
  {{ set prev = pagination.previous }}
  {{ set next = pagination.next }}

  {{ if prev }}
    <a href="{{ prev }}">Páxina anterior</a>
  {{ /if }}
  {{ if next }}
    <a href="{{ next }}">Páxina seguinte</a>
  {{ /if }}
</nav>
